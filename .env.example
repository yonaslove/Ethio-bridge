# Copy to .env and replace with local-only values. Never commit .env.

# --- PostgreSQL ---
POSTGRES_DB=ethiobridge
POSTGRES_USER=ethiobridge
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-local-only
KEYCLOAK_REALM=ethiobridge
KEYCLOAK_FRONTEND_CLIENT_ID=ethiobridge-frontend
KEYCLOAK_BACKEND_CLIENT_ID=ethiobridge-backend
KEYCLOAK_PORT=8180
# Browser-facing URL (what the SPA and token issuer use)
KEYCLOAK_PUBLIC_URL=http://localhost:8180

# --- Backend ---
CORS_ALLOWED_ORIGINS=http://localhost:4200
API_PUBLIC_URL=http://localhost:8080/api/v1

# --- AI service ---
AI_INTERNAL_TOKEN=change-me-local-only
AI_MODEL_NAME=sublinear-tfidf-char3gram-v1
